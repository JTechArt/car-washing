{
  "lva.dev.backendPort": 9080,
  "lva.dev.adminWebPort": 3400,
  "lva.dev.debugPort": 5005,
  "lva.dev.springProfile": "local",
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.import.maven.enabled": true,
  "java.import.maven.recursive": true,
  "maven.executable.path": "${workspaceFolder}/backend/mvnw",
  "java.debug.settings.hotCodeReplace": "auto",
  "java.debug.settings.console": "integratedTerminal",
  "java.import.exclusions": [
    "**/admin-web/**",
    "**/mobile/**",
    "**/node_modules/**",
    "**/target/**"
  ],
  "java.project.resourceFilters": ["node_modules", ".git"],
  "maven.executable.preferMavenWrapper": true,
  "maven.terminal.useJavaHome": true,
  "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx2G -Xms100m",
  "files.exclude": {
    "**/.classpath": true,
    "**/.project": true,
    "**/.settings": true,
    "**/.factorypath": true
  }
}
